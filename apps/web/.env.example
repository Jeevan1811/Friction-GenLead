# Optional: enables photorealistic 3D Google tiles on the Locations globe.
# Without either of these, the globe still works using free OpenStreetMap imagery.
# Cesium ion token is the easiest free path — sign up at https://ion.cesium.com and
# create an access token (free tier is generous). Direct Google Maps Platform key
# requires a billing-enabled Google Cloud project.
#
# Both must be NEXT_PUBLIC_ prefixed since they're read client-side in the browser bundle.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
