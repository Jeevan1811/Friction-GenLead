# Optional: enables photorealistic 3D Google tiles on the Locations globe.
# Without either of these, the globe still works using free OpenStreetMap imagery.
# Cesium ion token is the easiest free path — sign up at https://ion.cesium.com and
# create an access token (free tier is generous). Direct Google Maps Platform key
# requires a billing-enabled Google Cloud project.
#
# Both must be NEXT_PUBLIC_ prefixed since they're read client-side in the browser bundle.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Authentication -- single-account login (email + password + email OTP)
# ---------------------------------------------------------------------------
# The one account allowed to log in. OTP emails are also sent to this
# address.
AUTH_EMAIL=

# bcrypt hash of the account password -- NEVER the plaintext password.
# Generate with: node scripts/hash-password.mjs "the-actual-password"
#
# IMPORTANT: Next.js expands `$VAR`-style references inside .env files, and
# a bcrypt hash is full of literal `$` characters (e.g. $2b$12$...) that
# look exactly like that syntax. Escape every `$` as `\$` when you paste
# the hash in, or Next.js will silently mangle it and every login will
# fail with "Invalid email or password" even with the right password:
#   AUTH_PASSWORD_HASH=\$2b\$12\$abcdefghijklmnopqrstuv...
AUTH_PASSWORD_HASH=

# Secret for signing/verifying the session JWT (HS256). Must be the EXACT
# SAME value as AUTH_JWT_SECRET in services/research/.env -- both sides
# verify the same cookie independently, with no shared server state.
# Generate one with: openssl rand -hex 32
AUTH_JWT_SECRET=

# Hostinger SMTP -- used to email the 6-digit OTP on every login.
#
# IMPORTANT: if the password contains a `#`, dotenv treats it as the start
# of a comment on an unquoted value and silently truncates everything
# after it. Wrap the value in double quotes when that happens, and still
# escape any literal `$` as `\$` per the note above:
#   SMTP_PASS="R7!vQ2#nL9@xT4\$kM8pZ"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
