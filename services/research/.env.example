# OpenRouter API key for Llama chat responses
OPENROUTER_API_KEY=

# LLM model (default: meta-llama/llama-3.3-70b-instruct)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# TypeSafe AI (Jev) — fast structured-decision model for classification/
# scoring inside the pipeline. Not wired into the code yet.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=

# Alternative to GOOGLE_SHEETS_CREDENTIALS_PATH, for accounts where Google
# Cloud blocks service account key creation (common on personal-account
# projects under Google's secure-by-default policy). Create an OAuth 2.0
# Client ID of type "Desktop app" in Cloud Console -> APIs & Services ->
# Credentials, download its JSON, then run `python authorize_sheets.py`
# once locally to generate the token file.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=credentials/oauth_client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=credentials/oauth_token.json

# Server
PORT=8001
